# --- Links nos textos ---

msgid "%(link)s: there is no person with this identifier."
msgstr "%(link)s: não existe nenhuma pessoa com este identificador."

msgid "%(link)s: there is no place with this identifier."
msgstr "%(link)s: não existe nenhum lugar com este identificador."

msgid "%(link)s: there is no recipe with this identifier."
msgstr "%(link)s: não existe nenhuma receita com este identificador."

msgid "%(time)s: there is no interview to link this minute to."
msgstr "%(time)s: não há entrevista para ligar a este minuto."

msgid "%(link)s: only links to web pages (https://...) are allowed."
msgstr "%(link)s: só são permitidos links para páginas da web (https://...)."

# --- Comandos ---

msgid ""
"This command erases the database before loading the invented family, so it "
"only runs with RAIZES_DATASET=demo. The real family was not touched."
msgstr ""
"Este comando apaga o banco de dados antes de carregar a família inventada, "
"por isso só roda com RAIZES_DATASET=demo. A família real não foi tocada."

msgid ""
"Invented family loaded: %(people)d people, %(unions)d unions, %(places)d "
"places, %(recipes)d recipes."
msgstr ""
"Família inventada carregada: %(people)d pessoas, %(unions)d uniões, "
"%(places)d lugares, %(recipes)d receitas."

# --- Exportação ---

msgid "The site was not exported: some texts have links that point nowhere."
msgstr "O site não foi exportado: alguns textos têm links que não levam a lugar nenhum."

msgid "The exported site has links to files that do not exist."
msgstr "O site exportado tem links para arquivos que não existem."

msgid "%(folder)s is not a folder."
msgstr "%(folder)s não é uma pasta."

msgid ""
"The folder %(folder)s has files that were not created by the export, so it "
"was left untouched. Choose an empty folder."
msgstr ""
"A pasta %(folder)s tem arquivos que não foram criados pela exportação, por "
"isso não foi tocada. Escolha uma pasta vazia."

msgid "Site exported: %(pages)d pages, %(files)d files, %(size)s."
msgstr "Site exportado: %(pages)d páginas, %(files)d arquivos, %(size)s."

msgid "Open this file in the browser: %(path)s"
msgstr "Abra este arquivo no navegador: %(path)s"

