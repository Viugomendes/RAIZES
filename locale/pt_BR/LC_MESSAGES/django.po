# --- Modelos: textos de ajuda ---

msgid ""
"Format name-surname-year, for example: ramon-garcia-1962. Leave it empty to "
"have it created for you. It never changes afterwards."
msgstr ""
"Formato nome-sobrenome-ano, por exemplo: ramon-garcia-1962. Deixe em branco "
"para ele ser criado sozinho. Depois de criado, nunca muda."

msgid "Maiden name, other spellings. Separate them with commas."
msgstr "Nome de solteira, outras grafias. Separe com vírgulas."

msgid "Complete (14/03/1962) or just the year (1962). Empty if unknown."
msgstr "Completa (14/03/1962) ou só o ano (1962). Em branco se for desconhecida."

msgid "The site shows \"c. 1962\"."
msgstr "O site mostra \"c. 1962\"."

msgid "Tick it when the person has died, even if the date is unknown."
msgstr "Marque quando a pessoa já faleceu, mesmo sem saber a data."

msgid "Only the city, never the full address."
msgstr "Só a cidade, nunca o endereço completo."

msgid "Free words separated by commas, for example: musician, emigrant."
msgstr "Palavras livres separadas por vírgulas, por exemplo: músico, emigrante."

msgid ""
"Normal link of the video on YouTube: https://www.youtube.com/watch?v=CODE or "
"https://youtu.be/CODE."
msgstr ""
"Link normal do vídeo no YouTube: https://www.youtube.com/watch?v=CODIGO ou "
"https://youtu.be/CODIGO."

msgid "Untick it while the information about this person is doubtful."
msgstr "Desmarque enquanto as informações sobre esta pessoa forem duvidosas."

msgid "Where the information came from, for example: told by aunt Marta."
msgstr "De onde veio a informação, por exemplo: contado pela tia Marta."

msgid ""
"Optional. Written in Markdown. [[identifier]] links to a person and [mm:ss] "
"links to that minute of the interview."
msgstr ""
"Opcional. Escrito em Markdown. [[identificador]] cria um link para uma pessoa "
"e [mm:ss] para aquele minuto da entrevista."

msgid "Leave it empty when the other parent is unknown."
msgstr "Deixe em branco quando o outro pai ou mãe é desconhecido."

msgid "Leave it empty if you do not know."
msgstr "Deixe em branco se não souber."

msgid "Complete date or just the year. Empty if unknown."
msgstr "Data completa ou só o ano. Em branco se for desconhecido."

msgid "Empty means the union is still current."
msgstr "Em branco significa que a união continua."

msgid "Tick it when the union ended, even if the date is unknown."
msgstr "Marque quando a união terminou, mesmo sem saber a data."

msgid ""
"Optional, in Markdown. It appears in the section \"Love and friendship\" of "
"both partners."
msgstr ""
"Opcional, em Markdown. Aparece na seção \"Amor e amizade\" das duas fichas."

msgid "Short name used in links, for example: valencia."
msgstr "Nome curto usado nos links, por exemplo: valencia."

msgid "For example: Valência, Espanha."
msgstr "Por exemplo: Valência, Espanha."

msgid "Tick it when someone in the photo is unknown (\"Who is this?\")."
msgstr "Marque quando alguém na foto não foi identificado (\"Quem é?\")."

msgid "Short name used in links, for example: feijoada-da-vo."
msgstr "Nome curto usado nos links, por exemplo: feijoada-da-vo."

msgid "Written in Markdown."
msgstr "Escrito em Markdown."

# --- Modelos: mensagens de erro ---

msgid ""
"Paste the link of the video on YouTube, in one of these formats: "
"https://www.youtube.com/watch?v=CODE or https://youtu.be/CODE."
msgstr ""
"Cole o link do vídeo no YouTube, num destes formatos: "
"https://www.youtube.com/watch?v=CODIGO ou https://youtu.be/CODIGO."

msgid "Fill in both latitude and longitude, or neither."
msgstr "Preencha a latitude e a longitude, ou nenhuma das duas."

msgid ""
"The identifier cannot change after the person is created: every link to this "
"person depends on it."
msgstr ""
"O identificador não pode mudar depois que a pessoa é criada: todos os links "
"para ela dependem dele."

msgid ""
"Use only lowercase letters without accents, digits and hyphens, for example: "
"ramon-garcia-1962."
msgstr ""
"Use só letras minúsculas sem acento, números e hifens, por exemplo: "
"ramon-garcia-1962."

msgid "The death date is before the birth date."
msgstr "A data de falecimento é anterior à de nascimento."

msgid "%(name)s (other parent unknown)"
msgstr "%(name)s (pai ou mãe desconhecido)"

msgid "A union needs two different people."
msgstr "Uma união precisa de duas pessoas diferentes."

msgid "The end is before the start."
msgstr "O fim é anterior ao início."

msgid "This person is already a child of this union."
msgstr "Esta pessoa já é filha desta união."

msgid "A person cannot be a child of their own union."
msgstr "Uma pessoa não pode ser filha da própria união."

msgid ""
"This person is an ancestor of one of the partners, so cannot also be their "
"child."
msgstr ""
"Esta pessoa é antepassada de um dos parceiros, então não pode ser também "
"filha dele."

