msgid "site settings"
msgstr "configurações do site"

msgid "browser"
msgstr "navegador"

msgid "revoked"
msgstr "revogado"

msgid "viewer device"
msgstr "aparelho de visualização"

msgid "viewer devices"
msgstr "Conectados"

msgid "The family site is closed until a view password is set in the panel."
msgstr "O site da família está fechado até que uma senha de visualização seja definida no painel."

msgid "Too many wrong attempts. Wait 15 minutes and try again."
msgstr "Muitas tentativas erradas. Espere 15 minutos e tente de novo."

msgid "Wrong password. Check it and try again."
msgstr "Senha errada. Confira e tente de novo."

msgid "Family password"
msgstr "Senha da família"

msgid "Type the family password to see the site."
msgstr "Digite a senha da família para ver o site."

msgid "This device is already connected. Open the site"
msgstr "Este aparelho já está conectado. Abrir o site"

msgid "Your name"
msgstr "Seu nome"

msgid "(optional)"
msgstr "(opcional)"

msgid "So the family knows who is visiting."
msgstr "Para a família saber quem está visitando."

msgid "Password"
msgstr "Senha"

msgid "Open the site"
msgstr "Abrir o site"

msgid "This device stays connected for a year."
msgstr "Este aparelho fica conectado por um ano."

msgid "E-mail"
msgstr "E-mail"

msgid "Wrong e-mail or password. Check them and try again."
msgstr "E-mail ou senha errados. Confira e tente de novo."

msgid "Forgot the password"
msgstr "Esqueci a senha"

msgid "Log in"
msgstr "Entrar"

msgid "Another account already uses this e-mail."
msgstr "Outra conta já usa este e-mail."

msgid "New family password"
msgstr "Nova senha da família"

msgid "Leave empty to keep the current password. Minimum 8 characters."
msgstr "Deixe em branco para manter a senha atual. Mínimo de 8 caracteres."

msgid "Repeat the new password"
msgstr "Repita a nova senha"

msgid "The two passwords are different."
msgstr "As duas senhas são diferentes."

msgid "The password needs at least 8 characters."
msgstr "A senha precisa de pelo menos 8 caracteres."

msgid "Saving a new password disconnects every device. The site language is chosen in the installer (the .env file) and is not changed here."
msgstr "Salvar uma nova senha desconecta todos os aparelhos. O idioma do site é escolhido no instalador (o arquivo .env) e não muda aqui."

msgid "The new password was saved. All devices were disconnected."
msgstr "A nova senha foi salva. Todos os aparelhos foram desconectados."

msgid "online now"
msgstr "online agora"

msgid "Online now"
msgstr "Online agora"

msgid "Status"
msgstr "Situação"

msgid "Disconnected"
msgstr "Desconectado"

msgid "Online"
msgstr "Online"

msgid "Offline"
msgstr "Offline"

msgid "Entered"
msgstr "Entrou em"

msgid "Last visit"
msgstr "Última visita"

msgid "Disconnect the selected devices"
msgstr "Desconectar os aparelhos selecionados"

msgid "Devices disconnected: %(count)d."
msgstr "Aparelhos desconectados: %(count)d."

msgid "Leave"
msgstr "Sair"

msgid "The password cannot be only spaces."
msgstr "A senha não pode ser só espaços."

msgid ".env already exists and is different. Use --force to overwrite it."
msgstr ".env já existe e é diferente. Use --force para sobrescrevê-lo."

msgid "Backup restored."
msgstr "Cópia de segurança restaurada."

msgid "Backup saved: %(file)s"
msgstr "Cópia de segurança salva: %(file)s"

msgid "E-mail of the owner (it receives the password)."
msgstr "E-mail da dona (ele recebe a senha)."

msgid "Family name: "
msgstr "Nome da família: "

msgid "Family view password (8+ characters): "
msgstr "Senha de visualização da família (8 ou mais caracteres): "

msgid "File not found: %(file)s"
msgstr "Arquivo não encontrado: %(file)s"

msgid "Hello!\n\nThe panel is at /painel/ . Log in with this e-mail and this password:\n\n%(password)s\n\nKeep it safe."
msgstr "Olá!\n\nO painel fica em /painel/ . Entre com este e-mail e esta senha:\n\n%(password)s\n\nGuarde-a bem."

msgid "Installed. The site opens in the chosen language."
msgstr "Instalado. O site abre no idioma escolhido."

msgid "It holds private data and passwords: keep it in a safe place."
msgstr "Ela contém dados privados e senhas: guarde-a em um lugar seguro."

msgid "Language (pt-br or es): "
msgstr "Idioma (pt-br ou es): "

msgid "Language must be one of: %(options)s"
msgstr "O idioma deve ser um destes: %(options)s"

msgid "Language of the site: pt-br or es."
msgstr "Idioma do site: pt-br ou es."

msgid "Name of the family."
msgstr "Nome da família."

msgid "Never ask: every option is required."
msgstr "Nunca perguntar: todas as opções são obrigatórias."

msgid "Open on the home network: http://%(ip)s:%(port)d/"
msgstr "Abra na rede da casa: http://%(ip)s:%(port)d/"

msgid "Open on this computer: http://localhost:%(port)d/"
msgstr "Abra neste computador: http://localhost:%(port)d/"

msgid "Overwrite data that is already there."
msgstr "Sobrescrever os dados que já existem."

msgid "Password the family types to open the site (8+ characters)."
msgstr "Senha que a família digita para abrir o site (8 ou mais caracteres)."

msgid "Password to open the invented family: %(password)s"
msgstr "Senha para abrir a família inventada: %(password)s"

msgid "Port (default 8000)."
msgstr "Porta (padrão 8000)."

msgid "Press Ctrl+C to stop."
msgstr "Aperte Ctrl+C para parar."

msgid "Restores a backup made by the backup command."
msgstr "Restaura uma cópia feita pelo comando backup."

msgid "Serves the site and the panel to the devices of the home network."
msgstr "Serve o site e o painel aos aparelhos da rede da casa."

msgid "Sets up Raízes: language, family name, view password and the owner's account."
msgstr "Instala o Raízes: idioma, nome da família, senha de visualização e a conta da dona."

msgid "The backup .zip file."
msgstr "O arquivo .zip da cópia de segurança."

msgid "The backup is empty."
msgstr "A cópia de segurança está vazia."

msgid "The data folder is not empty. Use --force to overwrite it."
msgstr "A pasta de dados não está vazia. Use --force para sobrescrevê-la."

msgid "The e-mail could not be sent (e-mail is not configured yet; see the README, section about e-mail). Write this panel password down now, it will not be shown again:"
msgstr "Não foi possível enviar o e-mail (o e-mail ainda não está configurado; veja o README, seção sobre e-mail). Anote agora esta senha do painel, ela não será mostrada de novo:"

msgid "The panel password was sent to %(email)s."
msgstr "A senha do painel foi enviada para %(email)s."

msgid "The two passwords are not the same."
msgstr "As duas senhas não são iguais."

msgid "The view password needs at least %(count)d characters."
msgstr "A senha de visualização precisa de pelo menos %(count)d caracteres."

msgid "There is already an account with this e-mail."
msgstr "Já existe uma conta com este e-mail."

msgid "This backup does not belong here (unexpected entry: %(name)s)."
msgstr "Esta cópia não pertence a este lugar (item inesperado: %(name)s)."

msgid "This is not a valid backup file."
msgstr "Este não é um arquivo de cópia de segurança válido."

msgid "Type a valid e-mail."
msgstr "Digite um e-mail válido."

msgid "Type it again: "
msgstr "Digite de novo: "

msgid "Unsafe path inside the backup: %(name)s"
msgstr "Caminho inseguro dentro da cópia: %(name)s"

msgid "With --no-input, give --family-name, --language, --email and --view-password."
msgstr "Com --no-input, informe --family-name, --language, --email e --view-password."

msgid "Your Raízes panel password"
msgstr "A senha do seu painel do Raízes"

msgid "Your e-mail (the panel login): "
msgstr "Seu e-mail (o login do painel): "

msgid ".env could not be written (%(error)s). Nothing was installed."
msgstr ".env não pôde ser escrito (%(error)s). Nada foi instalado."

msgid "A backup with this name already exists. Wait a second and try again."
msgstr "Já existe uma cópia com este nome. Espere um segundo e tente de novo."

msgid "Address to listen on (default 127.0.0.1: this computer only)."
msgstr "Endereço em que escutar (padrão 127.0.0.1: só este computador)."

msgid "Debug mode is on (RAIZES_DEBUG), so the site cannot be opened to the network. Set RAIZES_DEBUG=false in .env and try again."
msgstr "O modo de depuração está ligado (RAIZES_DEBUG); por isso o site não pode ser aberto para a rede. Ponha RAIZES_DEBUG=false no .env e tente de novo."

msgid "Open the site to the devices of the home network (listens on 0.0.0.0)."
msgstr "Abre o site para os aparelhos da rede da casa (escuta em 0.0.0.0)."

msgid "Saves the data folder and .env into backups/raizes-YYYY-MM-DD-HHMMSS.zip."
msgstr "Salva a pasta de dados e o .env em backups/raizes-AAAA-MM-DD-HHMMSS.zip."
