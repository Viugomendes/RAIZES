# --- Modelos: textos de ayuda ---

msgid ""
"Format name-surname-year, for example: ramon-garcia-1962. Leave it empty to "
"have it created for you. It never changes afterwards."
msgstr ""
"Formato nombre-apellido-año, por ejemplo: ramon-garcia-1962. Déjalo en blanco "
"para que se cree solo. Una vez creado, nunca cambia."

msgid "Maiden name, other spellings. Separate them with commas."
msgstr "Apellido de soltera, otras grafías. Sepáralos con comas."

msgid "Complete (14/03/1962) or just the year (1962). Empty if unknown."
msgstr "Completa (14/03/1962) o solo el año (1962). En blanco si se desconoce."

msgid "The site shows \"c. 1962\"."
msgstr "El sitio muestra \"c. 1962\"."

msgid "Tick it when the person has died, even if the date is unknown."
msgstr "Márcalo cuando la persona ha fallecido, aunque no se sepa la fecha."

msgid "Only the city, never the full address."
msgstr "Solo la ciudad, nunca la dirección completa."

msgid "Free words separated by commas, for example: musician, emigrant."
msgstr "Palabras libres separadas por comas, por ejemplo: músico, emigrante."

msgid ""
"Normal link of the video on YouTube: https://www.youtube.com/watch?v=CODE or "
"https://youtu.be/CODE."
msgstr ""
"Enlace normal del vídeo en YouTube: https://www.youtube.com/watch?v=CODIGO o "
"https://youtu.be/CODIGO."

msgid "Untick it while the information about this person is doubtful."
msgstr "Desmárcalo mientras la información sobre esta persona sea dudosa."

msgid "Where the information came from, for example: told by aunt Marta."
msgstr "De dónde viene la información, por ejemplo: contado por la tía Marta."

msgid ""
"Optional. Written in Markdown. [[identifier]] links to a person and [mm:ss] "
"links to that minute of the interview."
msgstr ""
"Opcional. Escrito en Markdown. [[identificador]] crea un enlace a una persona "
"y [mm:ss] a ese minuto de la entrevista."

msgid "Leave it empty when the other parent is unknown."
msgstr "Déjalo en blanco cuando el otro padre o madre es desconocido."

msgid "Leave it empty if you do not know."
msgstr "Déjalo en blanco si no lo sabes."

msgid "Complete date or just the year. Empty if unknown."
msgstr "Fecha completa o solo el año. En blanco si se desconoce."

msgid "Empty means the union is still current."
msgstr "En blanco significa que la unión continúa."

msgid "Tick it when the union ended, even if the date is unknown."
msgstr "Márcalo cuando la unión terminó, aunque no se sepa la fecha."

msgid ""
"Optional, in Markdown. It appears in the section \"Love and friendship\" of "
"both partners."
msgstr ""
"Opcional, en Markdown. Aparece en la sección \"Amor y amistad\" de las dos "
"fichas."

msgid "Short name used in links, for example: valencia."
msgstr "Nombre corto usado en los enlaces, por ejemplo: valencia."

msgid "For example: Valência, Espanha."
msgstr "Por ejemplo: Valencia, España."

msgid "Tick it when someone in the photo is unknown (\"Who is this?\")."
msgstr "Márcalo cuando alguien de la foto no está identificado (\"¿Quién es?\")."

msgid "Short name used in links, for example: feijoada-da-vo."
msgstr "Nombre corto usado en los enlaces, por ejemplo: feijoada-da-vo."

msgid "Written in Markdown."
msgstr "Escrito en Markdown."

# --- Modelos: mensajes de error ---

msgid ""
"Paste the link of the video on YouTube, in one of these formats: "
"https://www.youtube.com/watch?v=CODE or https://youtu.be/CODE."
msgstr ""
"Pega el enlace del vídeo en YouTube, en uno de estos formatos: "
"https://www.youtube.com/watch?v=CODIGO o https://youtu.be/CODIGO."

msgid "Fill in both latitude and longitude, or neither."
msgstr "Rellena la latitud y la longitud, o ninguna de las dos."

msgid ""
"The identifier cannot change after the person is created: every link to this "
"person depends on it."
msgstr ""
"El identificador no puede cambiar después de crear la persona: todos los "
"enlaces a ella dependen de él."

msgid ""
"Use only lowercase letters without accents, digits and hyphens, for example: "
"ramon-garcia-1962."
msgstr ""
"Usa solo letras minúsculas sin acento, números y guiones, por ejemplo: "
"ramon-garcia-1962."

msgid "The death date is before the birth date."
msgstr "La fecha de fallecimiento es anterior a la de nacimiento."

msgid "%(name)s (other parent unknown)"
msgstr "%(name)s (padre o madre desconocido)"

msgid "A union needs two different people."
msgstr "Una unión necesita dos personas diferentes."

msgid "The end is before the start."
msgstr "El fin es anterior al inicio."

msgid "This person is already a child of this union."
msgstr "Esta persona ya es hija de esta unión."

msgid "A person cannot be a child of their own union."
msgstr "Una persona no puede ser hija de su propia unión."

msgid ""
"This person is an ancestor of one of the partners, so cannot also be their "
"child."
msgstr ""
"Esta persona es antepasada de uno de los miembros de la pareja, así que no "
"puede ser también su hija."

