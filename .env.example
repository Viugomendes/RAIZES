# Copy this file to ".env" and change what you need.
# ".env" is ignored by Git: nothing written there is published.
# The secret key (RAIZES_SECRET_KEY) is created automatically on the first run.

# Which family is loaded:
#   demo = the invented family in demo/ (default)
#   real = the real family in data/ (private)
RAIZES_DATASET=demo

# The person the tree is organised around (the identifier of a person).
# Leave empty with the invented family: it already has one.
RAIZES_CENTRAL_PERSON=

# Name shown at the top of every page, for example: Família Souza
RAIZES_FAMILY_NAME=
