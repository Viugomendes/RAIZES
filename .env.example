# Copy this file to ".env" and change what you need.
# ".env" is ignored by Git: nothing written there is published.
# The secret key (RAIZES_SECRET_KEY) is created automatically on the first run.

# Which family is loaded:
#   demo = the invented family in demo/ (default)
#   real = the real family in data/ (private)
# `instalar` writes real (or demo, with `instalar --demo`).
RAIZES_DATASET=demo

# The password `load_demo` gives the invented family. If you do not write it
# here, every `load_demo` makes a new one and shows it on the screen. Example:
# RAIZES_DEMO_PASSWORD=choose-one-here

# The person the tree is organised around (the identifier of a person).
# Leave empty with the invented family: it already has one.
RAIZES_CENTRAL_PERSON=

# Name shown at the top of every page, for example: Família Souza
RAIZES_FAMILY_NAME=

# Language the site opens in: pt-br or es.
RAIZES_LANGUAGE=pt-br

# Sections of the person page to hide, separated by commas. Possible values:
# tastes, childhood, work, love, origins, memories, legacy, remembrance, gallery
RAIZES_HIDDEN_SECTIONS=

# The family pages, photos and data ask for the view password (set it in the panel).
# true (default) or false (only for working alone on this computer, with runserver:
# servir and RAIZES_PUBLIC_URL refuse false).
RAIZES_VIEW_GATE=true

# ---------------------------------------------------------------
# Serving the site (README, "Onde hospedar")
# ---------------------------------------------------------------

# Debug mode shows pieces of the code when something goes wrong: only for programmers.
# Empty: on only without RAIZES_PUBLIC_URL and RAIZES_PROXY_HEADER; true with
# either of them is refused. `instalar` writes false; `servir` needs false.
RAIZES_DEBUG=

# The address the family opens, for example https://familia.example.org
# Empty: only this computer and the home network. With https:// the cookies
# only travel over HTTPS and the browser is told to always use HTTPS (HSTS).
RAIZES_PUBLIC_URL=

# Other names this site answers to, separated by commas (never "*").
RAIZES_EXTRA_HOSTS=

# Who tells the visitor's address when the site is behind a tunnel or a proxy:
#   empty            = no tunnel or proxy (default)
#   CF-Connecting-IP = Cloudflare Tunnel
#   X-Forwarded-For  = a proxy on the same computer, like Caddy
RAIZES_PROXY_HEADER=

# ---------------------------------------------------------------
# E-mail (README, "E-mail com o Gmail")
# ---------------------------------------------------------------
# Without RAIZES_EMAIL_HOST nothing is sent: e-mails are written as files in
# data/emails (or demo/emails), and `instalar` shows the panel password on the screen.

# The e-mail server, for example smtp.gmail.com
RAIZES_EMAIL_HOST=
# Its port: 587 (default, STARTTLS) or 465 (TLS from the start).
RAIZES_EMAIL_PORT=
# The account that sends, for example suafamilia@gmail.com
RAIZES_EMAIL_USER=
# Its password (with Gmail, an app password, without spaces).
RAIZES_EMAIL_PASSWORD=
# Who the e-mails come from. Empty: the same as RAIZES_EMAIL_USER.
RAIZES_EMAIL_FROM=
